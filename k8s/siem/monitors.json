[
  {
    "type": "monitor",
    "monitor_type": "bucket_level_monitor",
    "name": "AlienBank \u2014 Brute force (single account)",
    "enabled": true,
    "schedule": {
      "period": {
        "interval": 1,
        "unit": "MINUTES"
      }
    },
    "inputs": [
      {
        "search": {
          "indices": [
            "alienbank-security-*"
          ],
          "query": {
            "size": 0,
            "query": {
              "bool": {
                "filter": [
                  {
                    "range": {
                      "@timestamp": {
                        "gte": "now-10m",
                        "lte": "now",
                        "format": "epoch_millis||strict_date_optional_time"
                      }
                    }
                  },
                  {
                    "term": {
                      "event.action.keyword": "login"
                    }
                  },
                  {
                    "term": {
                      "event.outcome.keyword": "failure"
                    }
                  }
                ]
              }
            },
            "aggregations": {
              "composite_agg": {
                "composite": {
                  "sources": [
                    {
                      "grp": {
                        "terms": {
                          "field": "target_ref.keyword"
                        }
                      }
                    }
                  ],
                  "size": 50
                },
                "aggregations": {}
              }
            }
          }
        }
      }
    ],
    "triggers": [
      {
        "bucket_level_trigger": {
          "name": "AlienBank \u2014 Brute force (single account) \u2014 threshold",
          "severity": "2",
          "condition": {
            "buckets_path": {
              "bucket_count": "_count"
            },
            "parent_bucket_path": "composite_agg",
            "script": {
              "source": "params.bucket_count >= 5",
              "lang": "painless"
            }
          },
          "actions": []
        }
      }
    ]
  },
  {
    "type": "monitor",
    "monitor_type": "bucket_level_monitor",
    "name": "AlienBank \u2014 Credential spraying (one source, many accounts)",
    "enabled": true,
    "schedule": {
      "period": {
        "interval": 1,
        "unit": "MINUTES"
      }
    },
    "inputs": [
      {
        "search": {
          "indices": [
            "alienbank-security-*"
          ],
          "query": {
            "size": 0,
            "query": {
              "bool": {
                "filter": [
                  {
                    "range": {
                      "@timestamp": {
                        "gte": "now-10m",
                        "lte": "now",
                        "format": "epoch_millis||strict_date_optional_time"
                      }
                    }
                  },
                  {
                    "term": {
                      "event.action.keyword": "login"
                    }
                  },
                  {
                    "term": {
                      "event.outcome.keyword": "failure"
                    }
                  }
                ]
              }
            },
            "aggregations": {
              "composite_agg": {
                "composite": {
                  "sources": [
                    {
                      "grp": {
                        "terms": {
                          "field": "source.ip.keyword"
                        }
                      }
                    }
                  ],
                  "size": 50
                },
                "aggregations": {
                  "distinct": {
                    "cardinality": {
                      "field": "target_ref.keyword"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ],
    "triggers": [
      {
        "bucket_level_trigger": {
          "name": "AlienBank \u2014 Credential spraying (one source, many accounts) \u2014 threshold",
          "severity": "2",
          "condition": {
            "buckets_path": {
              "distinct": "distinct"
            },
            "parent_bucket_path": "composite_agg",
            "script": {
              "source": "params.distinct >= 5",
              "lang": "painless"
            }
          },
          "actions": []
        }
      }
    ]
  },
