# ---------------------------------------------------------------------------
# AlienBank configuration. Copy to `.env` and edit.
# (If a shared .env exists higher up the repo, its values are used as fallback.)
# ---------------------------------------------------------------------------

# Web server
ALIENBANK_HOST=127.0.0.1
ALIENBANK_PORT=8000
# Signs the session cookie AND keys the security-log `target_ref` (the HMAC token
# that correlates login attempts without logging the username). MUST be set to a
# random value in any real deployment: if it stays at the default, anyone who can
# read the logs can brute-force `target_ref` back to usernames. Generate one with
#   python -c "import secrets; print(secrets.token_hex(32))"
ALIENBANK_SECRET_KEY=change-me-to-a-random-hex-string

# --- Security lab toggle ---
# false (default) => agent tools are VULNERABLE to prompt injection / BOLA / escalation
# true            => agent tools bind to the authenticated session (secure, unbypassable)
ALIENBANK_SECURE_AGENT=false

# --- Difficulty level (the red-team gym) ---
# 0 Naive | 1 Hardened (D1 filter) | 2 Defended (+D2 guard +D3 tool guard) | 3 Hardest (indirect injection)
# Also switchable at runtime from the UI (Profile -> Security level).
ALIENBANK_LEVEL=0

# --- LLM provider: "bedrock" (default) or "ollama" ---
ALIENBANK_LLM_PROVIDER=bedrock
ALIENBANK_LLM_MAX_TOKENS=5000
ALIENBANK_LLM_TEMPERATURE=0

# Bedrock (OpenAI-compatible endpoint, bearer-token auth)
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_BASE_URL=https://bedrock-mantle.eu-west-2.api.aws/v1
ALIENBANK_LLM_MODEL=deepseek.v3.2

# Ollama (local, OpenAI-compatible). Set ALIENBANK_LLM_PROVIDER=ollama to use.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# ALIENBANK_LLM_MODEL=qwen2.5:3b-instruct

# --- D2 guard model (local Ollama) for security levels 2 and 3 ---
# Default: an instruct model answering ATTACK/SAFE (low false-positive on banking).
# A name containing "guard" auto-selects Llama-Guard moderation mode (over-blocks banking).
ALIENBANK_GUARD_MODEL=qwen2.5:3b-instruct
# ALIENBANK_GUARD_MODE=classifier            # or "moderation"
ALIENBANK_GUARD_BASE_URL=http://localhost:11434/v1
ALIENBANK_GUARD_API_KEY=ollama

# --- Real ML guardrails: ProtectAI LLM Guard (D6 input / D7 output) ---
# OPTIONAL and heavy (torch/transformers, ~2 GB). Install the extra first:
#   uv pip install -e '.[guard]'
# When off (or the package/models are missing) the D6/D7 layers FAIL OPEN.
# Active only at security levels 2 (D6) and 3 (D6+D7).
# ALIENBANK_LLMGUARD=true
# D6 input scanners (CSV). Injection-only by default — adding Anonymize/BanTopics
# over-blocks banking (account numbers read as PII). e.g. PromptInjection,Toxicity
# ALIENBANK_LLMGUARD_INPUT=PromptInjection
# D7 output scanners (CSV): Sensitive=PII/secret egress, Relevance=groundedness.
# ALIENBANK_LLMGUARD_OUTPUT=Sensitive,Relevance
# ALIENBANK_LLMGUARD_THRESHOLD=0.5

# --- Agentic RAG: open-source embeddings (Ollama) + ChromaDB ---
ALIENBANK_EMBED_MODEL=bge-m3
ALIENBANK_EMBED_BASE_URL=http://localhost:11434/v1
ALIENBANK_EMBED_API_KEY=ollama
# ALIENBANK_RAG_TOP_K=4
# ALIENBANK_CHROMA_PATH=data/chroma
# ALIENBANK_RAG_COLLECTION=alienbank_knowledge
